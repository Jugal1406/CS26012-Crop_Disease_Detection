# ==============================================================================
# Crop Disease Detection Backend - Environment Configuration Template
# Copy this file to .env and adjust values for your local environment:
#   copy .env.example .env (Windows) or cp .env.example .env (Linux/macOS)
# ==============================================================================

# Database Connection (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crop_disease_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# ML Confidence & Rejection Threshold
# Predictions with softmax probability below this threshold are marked 'low_confidence'
CONFIDENCE_THRESHOLD=0.70

# Max Upload File Size in Bytes (default 10MB)
MAX_UPLOAD_SIZE_BYTES=10485760

# Application Environment
APP_ENV=development
DEBUG_SQL=false

# Clerk Authentication (Server-Side Secret Key & JWKS)
# Obtain your secret key from https://dashboard.clerk.com/ -> API Keys
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
CLERK_JWKS_URL=https://teaching-terrier-8084.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://teaching-terrier-8084.clerk.accounts.dev

# Weather Provider (Module 13 - Open-Meteo)
# Open-Meteo works out-of-the-box without an API key (10,000 req/day free).
# If using a commercial Open-Meteo plan or alternative provider, set API key here:
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=
WEATHER_CACHE_MINUTES=30

# LLM Advisory Provider (Module 14 - Groq API with Multi-Key Rotation)
# Configure up to three Groq API keys from separate accounts for automatic failover
# when rate limits (HTTP 429) or token quotas are reached.
GROQ_API_KEY_1=your_first_groq_api_key_here
GROQ_API_KEY_2=your_second_groq_api_key_here
GROQ_API_KEY_3=your_third_groq_api_key_here
# Legacy single key fallback:
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
