# ==============================================================================
# CS26012-Crop_Disease_Detection - Comprehensive Git Ignore Rules
# ==============================================================================

# --- Secrets and Environment Files ---
.env
.env.*
!.env.example
!.env.*.example

# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/

# --- Jupyter Notebooks ---
.ipynb_checkpoints/

# --- Node / React Frontend ---
frontend/node_modules/
frontend/dist/
frontend/.vite/
dist/
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Runtime Uploads & Generated User Reports ---
backend/uploads/scans/*
!backend/uploads/scans/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
uploads/
*.tmp

# --- Local Databases & SQLite ---
*.sqlite
*.sqlite3
*.log

# --- Machine Learning Models ---
# Allow project production model artifacts in models/
*.pth
*.pt
*.h5
*.keras
!models/*.keras
!models/*.json

# --- Datasets (Raw data should not be committed to repo) ---
data/
dataset/
datasets/

# --- Repository Snapshots & Archives ---
archive/development-artifacts/*.zip
*.zip

# --- IDE & Operating System Files ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
desktop.ini